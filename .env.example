# Copy to .env and fill secrets. Never commit .env.
SQL_PASSWORD=change-me-strong
JWT_KEY=change-me-min-32-chars-secret-key!!
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5190
NEXT_PUBLIC_SIGNALR_URL=http://localhost:5190/hubs
# Simulated network latency for the local adapter, "min:max" in ms.
# Leave unset (or "0") for instant responses; e.g. "150:400" to test loading states.
# NEXT_PUBLIC_API_LATENCY=150:400
